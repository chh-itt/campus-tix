# 复制为 .env 后按需修改（docker-compose.prod.yml 自动读取）

# 数据库
MYSQL_ROOT_PASSWORD=root123456
MYSQL_PASSWORD=campustix123

# 订单支付时限（分钟）——演示用 2，生产建议 15
PAY_TTL_MINUTES=15

# 模拟支付签名密钥（生产务必更换）
MOCK_PAY_SECRET=change-me-in-prod

# 支付宝沙箱（不启用则使用模拟收银台）
ALIPAY_ENABLED=false

# DeepSeek API Key（AI 客服；留空则降级为纯检索答案）
DEEPSEEK_API_KEY=

# 公网访问地址（CORS 白名单）
PUBLIC_ORIGIN=http://localhost:8088
